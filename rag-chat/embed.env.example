# /opt/rag-chat/embed.env on the VPS (mode 600). The embedding service reads this file.
# Vertex (default). Query and stored document vectors must come from the same model.
EMBED_PROVIDER=vertex
EMBED_PROJECT=<gcp project with the Vertex AI API enabled>
EMBED_CREDENTIALS_FILE=/run/secrets/embed-sa.json

# Qwen3-Embedding behind an OpenAI-compatible endpoint. Switch only after the Qwen vectors table is populated
# and the backend reads it (RAG_VECTORS_TABLE=pncp.editais_embeddings_qwen in /opt/rag-chat/.env).
# EMBED_PROVIDER=qwen
# EMBED_BASE_URL=https://<your endpoint>/v1
# EMBED_API_KEY=<bearer key>
# EMBED_MODEL=qwen-embedding
# EMBED_DIM=768
