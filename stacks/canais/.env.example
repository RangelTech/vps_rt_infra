# Nomes das variaveis da pilha `canais`. Valores reais ficam SO em /opt/platform/secrets/canais.env (0600) na VPS.
# Gerar cada segredo com: openssl rand -hex 32   (nunca reutilizar entre variaveis). Nada aqui e segredo real.
MATRIX_SERVER_NAME=matrix.internal
TIMEZONE=America/Sao_Paulo
CANAIS_DATA=/opt/platform/data/canais

# Postgres dedicado (Synapse + 3 bridges)
MATRIX_POSTGRES_PASSWORD=

# Synapse
SYNAPSE_REGISTRATION_SHARED_SECRET=
SYNAPSE_MACAROON_SECRET_KEY=
SYNAPSE_FORM_SECRET=

# Appservice do gateway (aplicacao Matrix propria). O gateway le os mesmos valores em MATRIX_AS_TOKEN / MATRIX_HS_TOKEN.
GATEWAY_AS_ID=luar-gateway
GATEWAY_AS_URL=http://chatwoot-bridge:8000
GATEWAY_AS_TOKEN=
GATEWAY_HS_TOKEN=
GATEWAY_SENDER_LOCALPART=luar_gateway

# Bridges: tokens de appservice (um par por bridge)
META_AS_TOKEN=
META_HS_TOKEN=
INSTAGRAM_AS_TOKEN=
INSTAGRAM_HS_TOKEN=
WHATSAPP_AS_TOKEN=
WHATSAPP_HS_TOKEN=
# Segredo de provisionamento (gateway -> bridge). O gateway le o mesmo valor em BRIDGE_PROVISIONING_SECRET.
BRIDGE_PROVISIONING_SECRET=

# Admin Matrix (so comandos de manutencao dos bridges)
BRIDGE_ADMIN_MXID=@luar_admin:matrix.internal

# Limites (conservadores; ajustar so com numero medido, ver CH-0d)
META_MEM_LIMIT=512m
INSTAGRAM_MEM_LIMIT=512m
WHATSAPP_MEM_LIMIT=512m
SYNAPSE_MEM_LIMIT=1g
MATRIX_POSTGRES_MEM_LIMIT=768m
BACKFILL_DAYS=60
