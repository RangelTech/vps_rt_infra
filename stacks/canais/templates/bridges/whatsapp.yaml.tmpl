# mautrix-whatsapp v26.10 (substitui o Evolution). Config MINIMA; o resto herda o default da versao.
# Login por QR e por codigo de pareamento (flows `qr` / `pairing-code`) pela API de provisionamento, porta 29318.
# AGPL-3.0: imagem sem modificacao.
network:
  displayname_template: '{{or .BusinessName .PushName .JID}}'
  history_sync:
    request_full_sync: false
    # janela do historico: ultimos ${BACKFILL_DAYS} dias (CH-0f valida)
    max_initial_conversations: 50
bridge:
  command_prefix: '!wa'
  personal_filtering_spaces: false
  private_chat_portal_meta: true
  bridge_notices: false
  kick_matrix_users: true
  permissions:
    "${MATRIX_SERVER_NAME}": user
    "${BRIDGE_ADMIN_MXID}": admin
  relay:
    enabled: false
database:
  type: postgres
  uri: postgres://matrix_admin:${MATRIX_POSTGRES_PASSWORD}@matrix-postgres:5432/mautrix_whatsapp?sslmode=disable
  max_open_conns: 5
  max_idle_conns: 1
homeserver:
  address: http://synapse:8008
  domain: ${MATRIX_SERVER_NAME}
  software: standard
  async_media: false
appservice:
  address: http://mautrix-whatsapp:29318
  hostname: 0.0.0.0
  port: 29318
  id: whatsapp
  bot:
    username: whatsappbot
    displayname: WhatsApp bridge bot
  ephemeral_events: true
  as_token: ${WHATSAPP_AS_TOKEN}
  hs_token: ${WHATSAPP_HS_TOKEN}
  username_template: whatsapp_{{.}}
matrix:
  message_status_events: true
  delivery_receipts: true
  message_error_notices: true
  federate_rooms: false
analytics:
  token: ""
provisioning:
  shared_secret: ${BRIDGE_PROVISIONING_SECRET}
  allow_matrix_auth: false
  debug_endpoints: false
  enable_session_transfers: false
direct_media:
  enabled: false
public_media:
  enabled: false
backfill:
  enabled: true
  max_initial_messages: 50
  max_catchup_messages: 500
double_puppet:
  servers: {}
  allow_discovery: false
encryption:
  allow: false
  default: false
  require: false
logging:
  min_level: info
  writers:
    - type: stdout
      format: json
