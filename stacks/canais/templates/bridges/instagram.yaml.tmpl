# mautrix-instagram (imagem ig-v26.10 do repo mautrix/meta). Config MINIMA; o resto herda o default da versao.
# SEM cookies. Login `android` (usuario/senha + 2FA) pela API de provisionamento. O fluxo "instagram-password"
# (webview) e o de cookies NAO sao usados pelo gateway. AGPL-3.0: imagem sem modificacao.
network:
  mode: instagram
  displayname_template: '{{or .DisplayName .Username "Unknown user"}}'
  proxy_media: false
  min_full_reconnect_interval_seconds: 3600
bridge:
  command_prefix: '!ig'
  personal_filtering_spaces: false
  private_chat_portal_meta: true
  bridge_notices: false
  kick_matrix_users: true
  permissions:
    "${MATRIX_SERVER_NAME}": user
    "${BRIDGE_ADMIN_MXID}": admin
  relay:
    enabled: false
database:
  type: postgres
  uri: postgres://matrix_admin:${MATRIX_POSTGRES_PASSWORD}@matrix-postgres:5432/mautrix_instagram?sslmode=disable
  max_open_conns: 5
  max_idle_conns: 1
homeserver:
  address: http://synapse:8008
  domain: ${MATRIX_SERVER_NAME}
  software: standard
  async_media: false
appservice:
  address: http://mautrix-instagram:29319
  hostname: 0.0.0.0
  port: 29319
  id: instagram
  bot:
    username: instagrambot
    displayname: Instagram bridge bot
  ephemeral_events: true
  as_token: ${INSTAGRAM_AS_TOKEN}
  hs_token: ${INSTAGRAM_HS_TOKEN}
  username_template: instagram_{{.}}
matrix:
  message_status_events: true
  delivery_receipts: true
  message_error_notices: true
  federate_rooms: false
analytics:
  token: ""
provisioning:
  shared_secret: ${BRIDGE_PROVISIONING_SECRET}
  allow_matrix_auth: false
  debug_endpoints: false
  enable_session_transfers: false
direct_media:
  enabled: false
public_media:
  enabled: false
backfill:
  enabled: true
  max_initial_messages: 50
  max_catchup_messages: 500
double_puppet:
  servers: {}
  allow_discovery: false
encryption:
  allow: false
  default: false
  require: false
logging:
  min_level: info
  writers:
    - type: stdout
      format: json
