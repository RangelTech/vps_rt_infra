ROOT_DOMAIN=${root_domain}
LETSENCRYPT_EMAIL=${letsencrypt_email}
TIMEZONE=${timezone}

POSTGRES_VERSION=${postgres_version}
POSTGRES_DB=${postgres_db}
POSTGRES_ADMIN_USER=${postgres_admin_user}
POSTGRES_ADMIN_PASSWORD=${postgres_admin_password}

PGBOUNCER_VERSION=${pgbouncer_version}
PGBOUNCER_ADMIN_USER=${pgbouncer_admin_user}
PGBOUNCER_ADMIN_PASSWORD=${pgbouncer_admin_password}

REDIS_VERSION=${redis_version}
REDIS_PASSWORD=${redis_password}

MINIO_VERSION=${minio_version}
MINIO_ROOT_USER=${minio_root_user}
MINIO_ROOT_PASSWORD=${minio_root_password}

PGADMIN_VERSION=${pgadmin_version}
PGADMIN_EMAIL=${pgadmin_email}
PGADMIN_PASSWORD=${pgadmin_password}

GRAFANA_VERSION=${grafana_version}
GRAFANA_ADMIN_USER=${grafana_admin_user}
GRAFANA_ADMIN_PASSWORD=${grafana_admin_password}

UPTIME_KUMA_VERSION=${uptime_kuma_version}
UPTIME_KUMA_USER=${uptime_kuma_user}
UPTIME_KUMA_PASSWORD=${uptime_kuma_password}

TRAEFIK_VERSION=${traefik_version}
TRAEFIK_BASIC_AUTH=${traefik_basic_auth}

CODE_SERVER_VERSION=${code_server_version}
CODE_SERVER_PASSWORD=${code_server_password}
CODE_SERVER_SUDO_PASSWORD=${code_server_sudo_password}

PROMETHEUS_VERSION=${prometheus_version}
LOKI_VERSION=${loki_version}
PROMTAIL_VERSION=${promtail_version}
NODE_EXPORTER_VERSION=${node_exporter_version}
CADVISOR_VERSION=${cadvisor_version}

NINEROUTER_PACKAGE=${ninerouter_package}
NINEROUTER_PORT=${ninerouter_port}

INFISICAL_VERSION=${infisical_version}
INFISICAL_DB_PASSWORD=${infisical_db_password}
INFISICAL_REDIS_PASSWORD=${infisical_redis_password}
INFISICAL_ENCRYPTION_KEY=${infisical_encryption_key}
INFISICAL_AUTH_SECRET=${infisical_auth_secret}

RESTIC_REPOSITORY=${restic_repository}
RESTIC_PASSWORD=${restic_password}
%{ for key, value in restic_environment ~}
${key}=${value}
%{ endfor ~}
