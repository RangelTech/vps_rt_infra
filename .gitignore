# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
.terraform.lock.hcl

# Secrets / env
.env
compose/.env
configs/synapse/homeserver.yaml
configs/synapse/registrations/facebook.yaml
configs/synapse/registrations/instagram.yaml
configs/mautrix-meta/facebook-config.yaml
configs/mautrix-meta/instagram-config.yaml
*.pem
*.key
userlist.txt
!userlist.txt.example
secrets-bootstrap-summary.txt

# Generated logs / diagnostics
run-*-logs/
ssh_diag_out.txt
_diag_ssh.py
_diag_ssh2.py

# Portfolio static export, rsynced by deploy-portfolio.yml from a pinned tag
sites/portfolio/public/*
!sites/portfolio/public/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
